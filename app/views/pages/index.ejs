<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lista 1 exemplo 04</title>
       <link rel="stylesheet" href="css/estilo.css">
</head>
<body>

   <%
    let  erroValidacao =  {"nota":""};
    let  msgErro =  {"nota":""};
    if(erros) {
         erros.errors.forEach(function(erro) {
             if (erro.path == "nota") {
                erroValidacao.nota = "erro",
                msgErro.nota = erro.msg
             }

         })
     }; %>

    <h1>Classificação de Nadadores</h1>

  <form method="post" action="/index">
        <label for="nota">Resultado:</label>
        <input type="text" name="nota" id="nota" value="<%= valores.nota %>"class="<%= erroValidacao.nota %>">
        <span><%= msgErro.nota %></span> <br>
     </form>



    <% if(resultado){ // com dados de retorno %>
        <h2>Categoria: <%= resultado.resul %>
        </h2>

        <% }else{ //sem dados de retorno %>
            <h2>Não temos retorno</h2>
            <% } %>


</body>

</html>